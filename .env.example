# Supabase Configuration

# Browser-safe (NEXT_PUBLIC_*) variables — these are inlined into the client bundle.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: public origin used for auth email redirects (password recovery).
# Leave unset in local dev (defaults to http://localhost:3000) and in the
# Vercel production build (defaults to https://miraclecollection.co.in).
# The resulting /reset-password URL must be allow-listed in Supabase Auth
# → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never import into client code.
# This key bypasses Row Level Security; leave it blank here and set it only in
# your server environment / .env.local (which is git-ignored).
SUPABASE_SERVICE_ROLE_KEY=
